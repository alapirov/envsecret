#!/usr/bin/env python3
"""envsecret: a small TUI for the macOS keychain secrets used by the shell.

Items are generic passwords labelled "envsecret [group] NAME", with the
variable name as the service. The list never reads a value; a value is only
decrypted when you open its card with Enter.

  arrows / j k   move            enter   open the card
  a              add             d       delete
  /              filter          q       quit

In a card: c copies to the clipboard, esc goes back.
Anything copied is wiped from the clipboard when you quit.

  envsecret --list    names only, no TUI, for scripting
"""
import curses
import os
import re
import subprocess
import sys

KEYCHAIN = os.path.expanduser("~/Library/Keychains/login.keychain-db")
ACCOUNT = os.environ.get("USER", "")
LABEL_RE = re.compile(r'0x00000007 <blob>="envsecret \[([^\]]+)\] ([^"]+)"')


# ---------------------------------------------------------------- keychain

def index():
    """[(group, name)] sorted. Reads metadata only, never a value."""
    out = subprocess.run(["security", "dump-keychain", KEYCHAIN],
                         capture_output=True, text=True).stdout
    return sorted(LABEL_RE.findall(out), key=lambda r: (r[0], r[1]))


def read_value(name):
    r = subprocess.run(["security", "find-generic-password",
                        "-a", ACCOUNT, "-s", name, "-w"],
                       capture_output=True, text=True)
    return r.stdout.rstrip("\n") if r.returncode == 0 else None


def write_value(group, name, value, note):
    # security prompts for the value and a confirmation, so feed it twice.
    # Passing it as -w <value> would expose it in ps output.
    #
    # start_new_session is load-bearing: security's -w prompt goes through
    # readpassphrase(), which opens /dev/tty whenever a controlling terminal
    # exists and then ignores this pipe entirely, writing its own prompts
    # straight to the terminal and blocking on keystrokes. Under curses that
    # reads as a hang with "password data for new item:" bleeding through the
    # UI. setsid() leaves us with no controlling terminal, so readpassphrase
    # falls back to stdin and consumes the value we piped.
    p = subprocess.run(["security", "add-generic-password", "-a", ACCOUNT,
                        "-s", name, "-l", f"envsecret [{group}] {name}",
                        "-j", note, "-T", "/usr/bin/security", "-U", "-w"],
                       input=f"{value}\n{value}\n", capture_output=True, text=True,
                       start_new_session=True)
    return p.returncode == 0


def delete_value(name):
    return subprocess.run(["security", "delete-generic-password",
                           "-a", ACCOUNT, "-s", name],
                          capture_output=True).returncode == 0


def clip(text):
    try:
        subprocess.run(["pbcopy"], input=text, text=True, check=True)
        return True
    except Exception:
        return False


# -------------------------------------------------------------------- ui

C_DIM, C_KEY, C_VAL, C_WARN, C_HEAD = 1, 2, 3, 4, 5


def draw_frame(scr, title, hint):
    h, w = scr.getmaxyx()
    scr.erase()
    scr.attron(curses.color_pair(C_HEAD) | curses.A_BOLD)
    scr.addstr(0, 0, f" {title}".ljust(w - 1)[:w - 1])
    scr.attroff(curses.color_pair(C_HEAD) | curses.A_BOLD)
    scr.attron(curses.color_pair(C_DIM))
    scr.addstr(h - 1, 0, f" {hint}".ljust(w - 1)[:w - 1])
    scr.attroff(curses.color_pair(C_DIM))
    return h, w


def prompt(scr, label, mask=False):
    """One-line editor on the bottom row. Esc cancels and returns None."""
    h, w = scr.getmaxyx()
    buf = ""
    curses.curs_set(1)
    try:
        while True:
            shown = ("*" * len(buf)) if mask else buf
            scr.move(h - 1, 0)
            scr.clrtoeol()
            scr.attron(curses.color_pair(C_KEY))
            scr.addstr(h - 1, 0, f" {label}")
            scr.attroff(curses.color_pair(C_KEY))
            scr.addstr(h - 1, len(label) + 2, shown[: max(0, w - len(label) - 3)])
            scr.refresh()
            ch = scr.getch()
            if ch == 27:                       # esc
                return None
            if ch in (10, 13):                 # enter
                return buf
            if ch in (curses.KEY_BACKSPACE, 127, 8):
                buf = buf[:-1]
            elif 32 <= ch < 127:
                buf += chr(ch)
    finally:
        curses.curs_set(0)


def confirm(scr, question):
    h, w = scr.getmaxyx()
    # curses refuses a write that reaches the terminal's last cell, so a long
    # name used to crash here. Clip the question, keep [y/N] on screen.
    tail = " [y/N] "
    room = w - 1 - len(tail)
    text = f" {question}"
    if len(text) > room:
        text = text[: max(0, room - 1)] + "…"
    scr.move(h - 1, 0)
    scr.clrtoeol()
    scr.attron(curses.color_pair(C_WARN) | curses.A_BOLD)
    scr.addstr(h - 1, 0, (text + tail)[: w - 1])
    scr.attroff(curses.color_pair(C_WARN) | curses.A_BOLD)
    scr.refresh()
    return scr.getch() in (ord("y"), ord("Y"))


def flash(scr, msg, pair=C_VAL):
    h, w = scr.getmaxyx()
    scr.move(h - 1, 0)
    scr.clrtoeol()
    scr.attron(curses.color_pair(pair) | curses.A_BOLD)
    scr.addstr(h - 1, 0, f" {msg}"[: w - 1])
    scr.attroff(curses.color_pair(pair) | curses.A_BOLD)
    scr.refresh()
    curses.napms(900)


def card(scr, group, name, copied):
    """Open one secret. The value is decrypted here and nowhere else."""
    value = read_value(name)
    if value is None:
        flash(scr, f"could not read {name}", C_WARN)
        return
    revealed = True
    while True:
        h, w = draw_frame(scr, f"envsecret  ·  {name}",
                          "c copy   r hide/show   esc back")
        rows = [("group", group), ("variable", name), ("length", f"{len(value)} chars")]
        y = 2
        for k, v in rows:
            scr.attron(curses.color_pair(C_DIM))
            scr.addstr(y, 2, f"{k:<10}")
            scr.attroff(curses.color_pair(C_DIM))
            scr.addstr(y, 13, v[: w - 15])
            y += 1
        y += 1
        scr.attron(curses.color_pair(C_DIM))
        scr.addstr(y, 2, "value")
        scr.attroff(curses.color_pair(C_DIM))
        y += 1
        shown = value if revealed else "*" * min(len(value), 48)
        # wrap the value across the width
        width = max(10, w - 6)
        scr.attron(curses.color_pair(C_VAL))
        for i in range(0, len(shown), width):
            if y >= h - 2:
                scr.addstr(y, 4, "...")
                break
            scr.addstr(y, 4, shown[i:i + width])
            y += 1
        scr.attroff(curses.color_pair(C_VAL))
        scr.refresh()

        ch = scr.getch()
        if ch in (27, ord("q"), curses.KEY_LEFT):
            return
        if ch in (ord("c"), ord("y")):
            if clip(value):
                copied.add(name)
                flash(scr, "copied to clipboard, cleared when you quit")
            else:
                flash(scr, "clipboard unavailable", C_WARN)
        elif ch == ord("r"):
            revealed = not revealed


NAME_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")

ADD_FIELDS = (
    ("Group",         False, "loads with `loadgroup <group>`, e.g. cloudflare"),
    ("Variable name", False, "UPPER_SNAKE_CASE, normalised on save"),
    ("Secret value",  True,  "never echoed; pasting is fine"),
)


def read_key(win):
    """getch that swallows escape sequences instead of reading them as Esc.

    Terminals in bracketed-paste mode wrap a paste in ESC[200~ ... ESC[201~.
    Treating that leading ESC as "cancel" would abort the form the instant a
    secret is pasted, which is the one thing this field exists for. A lone Esc
    is the case where nothing follows it. Returns None for "ignore this".
    """
    ch = win.getch()
    if ch != 27:
        return ch
    win.nodelay(True)
    try:
        nxt = win.getch()
        if nxt == -1:
            return 27                       # real, lone Esc
        if nxt == ord("["):                 # consume the rest of the CSI seq
            for _ in range(8):
                c = win.getch()
                if c == -1 or 0x40 <= c < 0x7F:
                    break
        return None
    finally:
        win.nodelay(False)


def add_flow(scr):
    """Three labelled fields in one panel, so the secret has a field of its own."""
    h, w = scr.getmaxyx()
    if h < 16 or w < 46:
        flash(scr, "terminal too small for the add form", C_WARN)
        return False

    vals = ["", "", ""]
    idx, error = 0, ""
    existing = {n for _, n in index()}
    bh, bw = 15, min(w - 4, 68)
    win = curses.newwin(bh, bw, (h - bh) // 2, (w - bw) // 2)
    win.keypad(True)
    curses.curs_set(1)
    try:
        while True:
            win.erase()
            win.box()
            win.attron(curses.color_pair(C_HEAD) | curses.A_BOLD)
            win.addstr(0, 2, " add secret ")
            win.attroff(curses.color_pair(C_HEAD) | curses.A_BOLD)

            inner = bw - 8
            cy = cx = 1
            for i, (label, mask, _) in enumerate(ADD_FIELDS):
                row, active = 2 + i * 3, i == idx
                lab = curses.color_pair(C_KEY) | curses.A_BOLD if active else curses.color_pair(C_DIM)
                win.attron(lab)
                win.addstr(row, 3, label)
                win.attroff(lab)
                shown = ("*" * len(vals[i])) if mask else vals[i]
                shown = shown[-inner:]          # keep the tail visible while typing
                box = curses.color_pair(C_VAL) if active else curses.color_pair(C_DIM)
                win.attron(box)
                win.addstr(row + 1, 3, "[" + shown.ljust(inner) + "]")
                win.attroff(box)
                if active:
                    cy, cx = row + 1, 4 + len(shown)

            if error:
                win.attron(curses.color_pair(C_WARN) | curses.A_BOLD)
                win.addstr(bh - 3, 3, error[:bw - 6])
                win.attroff(curses.color_pair(C_WARN) | curses.A_BOLD)
            else:
                win.attron(curses.color_pair(C_DIM))
                win.addstr(bh - 3, 3, ADD_FIELDS[idx][2][:bw - 6])
                win.attroff(curses.color_pair(C_DIM))
            win.attron(curses.color_pair(C_DIM))
            win.addstr(bh - 2, 3, "tab move · enter next · ^s save · esc cancel"[:bw - 6])
            win.attroff(curses.color_pair(C_DIM))

            win.move(cy, cx)
            win.refresh()

            ch = read_key(win)
            if ch is None:
                continue
            if ch == 27:
                return False
            if ch in (9, curses.KEY_DOWN):
                idx, error = (idx + 1) % 3, ""
            elif ch in (curses.KEY_BTAB, curses.KEY_UP):
                idx, error = (idx - 1) % 3, ""
            elif ch in (curses.KEY_BACKSPACE, 127, 8):
                vals[idx] = vals[idx][:-1]
            elif 32 <= ch < 127:
                vals[idx] += chr(ch)
            elif ch in (10, 13) and idx < 2:
                idx, error = idx + 1, ""
            elif ch in (10, 13, 19):            # enter on last field, or ^s
                group = vals[0].strip()
                name = vals[1].strip().upper().replace(" ", "_").replace("-", "_")
                value = vals[2]
                if not group:
                    idx, error = 0, "group is required"
                elif not NAME_RE.match(name):
                    idx, error = 1, "must be a valid shell variable name"
                elif name in existing:
                    idx, error = 1, f"{name} already exists; open it to change the value"
                elif not value:
                    idx, error = 2, "value is empty"
                else:
                    vals[1] = name
                    if write_value(group, name, value, "added via envsecret"):
                        curses.curs_set(0)
                        flash(scr, f"added {name} to [{group}]")
                        return True
                    error = "keychain write failed"
    finally:
        curses.curs_set(0)
        scr.touchwin()
        scr.refresh()


def run(scr):
    curses.curs_set(0)
    curses.use_default_colors()
    for pair, fg in ((C_DIM, 8), (C_KEY, 6), (C_VAL, 2), (C_WARN, 1), (C_HEAD, 4)):
        try:
            curses.init_pair(pair, fg, -1)
        except curses.error:
            curses.init_pair(pair, curses.COLOR_WHITE, -1)

    items = index()
    sel, top, filt, copied = 0, 0, "", set()

    while True:
        shown = [(g, n) for g, n in items
                 if filt.lower() in f"{g} {n}".lower()] if filt else items
        sel = max(0, min(sel, len(shown) - 1))
        title = f"envsecret  ·  {len(shown)} secret{'s' if len(shown) != 1 else ''}"
        if filt:
            title += f"  ·  filter: {filt}"
        h, w = draw_frame(scr, title,
                          "enter open   a add   d delete   / filter   q quit")

        body = h - 3
        if sel < top:
            top = sel
        if sel >= top + body:
            top = sel - body + 1

        last_group = None
        y = 2
        for i in range(top, min(len(shown), top + body)):
            g, n = shown[i]
            mark = "> " if i == sel else "  "
            grp = f"{g:<11}" if g != last_group else " " * 11
            last_group = g
            line = f"{mark}{grp}{n}"
            pad = max(0, w - len(line) - 14)
            line = f"{line}{' ' * pad}{'*' * 8}"
            # Zebra striping keyed to the item's index, not the screen row, so a
            # row keeps its shade while scrolling instead of flickering between
            # shades as the viewport moves. A_DIM only touches the glyphs, so no
            # full-width background padding is needed.
            attr = curses.A_REVERSE if i == sel else (curses.A_DIM if i % 2 else curses.A_NORMAL)
            scr.attron(attr)
            scr.addstr(y, 0, line[: w - 1])
            scr.attroff(attr)
            y += 1

        if not shown:
            scr.attron(curses.color_pair(C_DIM))
            scr.addstr(3, 2, "nothing here. press 'a' to add one.")
            scr.attroff(curses.color_pair(C_DIM))
        scr.refresh()

        ch = scr.getch()
        if ch == ord("q"):
            break
        elif ch == 27:                 # esc clears a filter, else asks first
            if filt:
                filt, sel = "", 0
            elif confirm(scr, "quit envsecret?"):
                break
        elif ch in (curses.KEY_DOWN, ord("j")):
            sel += 1
        elif ch in (curses.KEY_UP, ord("k")):
            sel -= 1
        elif ch == curses.KEY_NPAGE:
            sel += body
        elif ch == curses.KEY_PPAGE:
            sel -= body
        elif ch in (10, 13, curses.KEY_RIGHT) and shown:
            card(scr, shown[sel][0], shown[sel][1], copied)
        elif ch == ord("/"):
            got = prompt(scr, "filter:")
            filt = got or ""
            sel = 0
        elif ch == ord("a"):
            if add_flow(scr):
                items = index()
        elif ch == ord("d") and shown:
            g, n = shown[sel]
            if confirm(scr, f"delete {n} from [{g}]? this cannot be undone."):
                if delete_value(n):
                    flash(scr, f"deleted {n}")
                    items = index()
                    sel = max(0, sel - 1)
                else:
                    flash(scr, "delete failed", C_WARN)

    if copied:
        clip("")          # do not leave a secret sitting in the clipboard


def main():
    if not ACCOUNT:
        sys.exit("envsecret: $USER is not set")
    if "--list" in sys.argv:
        for g, n in index():
            print(f"{g:<12}{n}")
        return
    if "-h" in sys.argv or "--help" in sys.argv:
        print(__doc__.strip())
        return
    try:
        curses.wrapper(run)
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
