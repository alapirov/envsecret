#!/usr/bin/env python3
"""envsecret: a small TUI for the macOS keychain secrets used by the shell.

Items are generic passwords labelled "envsecret [group] NAME", with the
variable name as the service. The list never reads a value; a value is only
decrypted when you open its card with Enter.

  arrows / j k   move            enter   open the card
  a              add             e       edit
  d              delete          /       filter
  t              colour scheme   q       quit

In a card: c copies to the clipboard, e edits, esc goes back.
Anything copied is wiped from the clipboard when you quit.

  envsecret --list          names only, no TUI, for scripting
  envsecret --themes        the colour schemes on offer
  envsecret --theme NAME    run in one without saving it
"""
import curses
import locale
import os
import re
import subprocess
import sys
import termios

KEYCHAIN = os.path.expanduser("~/Library/Keychains/login.keychain-db")
ACCOUNT = os.environ.get("USER", "")
LABEL_RE = re.compile(r'0x00000007 <blob>="envsecret \[([^\]]+)\] ([^"]+)"')


# ---------------------------------------------------------------- keychain

def index():
    """[(group, name)] sorted. Reads metadata only, never a value."""
    out = subprocess.run(["security", "dump-keychain", KEYCHAIN],
                         capture_output=True, text=True).stdout
    return sorted(LABEL_RE.findall(out), key=lambda r: (r[0], r[1]))


def read_value(name):
    r = subprocess.run(["security", "find-generic-password",
                        "-a", ACCOUNT, "-s", name, "-w"],
                       capture_output=True, text=True)
    return r.stdout.rstrip("\n") if r.returncode == 0 else None


def write_value(group, name, value, note):
    # security prompts for the value and a confirmation, so feed it twice.
    # Passing it as -w <value> would expose it in ps output.
    #
    # start_new_session is load-bearing: security's -w prompt goes through
    # readpassphrase(), which opens /dev/tty whenever a controlling terminal
    # exists and then ignores this pipe entirely, writing its own prompts
    # straight to the terminal and blocking on keystrokes. Under curses that
    # reads as a hang with "password data for new item:" bleeding through the
    # UI. setsid() leaves us with no controlling terminal, so readpassphrase
    # falls back to stdin and consumes the value we piped.
    p = subprocess.run(["security", "add-generic-password", "-a", ACCOUNT,
                        "-s", name, "-l", f"envsecret [{group}] {name}",
                        "-j", note, "-T", "/usr/bin/security", "-U", "-w"],
                       input=f"{value}\n{value}\n", capture_output=True, text=True,
                       start_new_session=True)
    return p.returncode == 0


def delete_value(name):
    return subprocess.run(["security", "delete-generic-password",
                           "-a", ACCOUNT, "-s", name],
                          capture_output=True).returncode == 0


def clip(text):
    try:
        subprocess.run(["pbcopy"], input=text, text=True, check=True)
        return True
    except Exception:
        return False


# ---------------------------------------------------------------- settings

CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME",
                                     os.path.expanduser("~/.config")),
                      "envsecret", "config")


def load_config():
    """`key = value` lines. A missing or unreadable file is just defaults."""
    cfg = {}
    try:
        with open(CONFIG) as f:
            for line in f:
                line = line.split("#", 1)[0].strip()
                if "=" in line:
                    k, v = line.split("=", 1)
                    cfg[k.strip()] = v.strip()
    except OSError:
        pass
    return cfg


def save_setting(key, value):
    cfg = load_config()
    cfg[key] = value
    try:
        os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
        tmp = f"{CONFIG}.new"
        with open(tmp, "w") as f:
            f.write("# envsecret settings\n")
            for k, v in sorted(cfg.items()):
                f.write(f"{k} = {v}\n")
        os.replace(tmp, CONFIG)                 # never a half-written config
        return True
    except OSError:
        return False


