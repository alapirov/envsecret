#!/usr/bin/env python3
"""envsecret: a small TUI for the macOS keychain secrets used by the shell.

Items are generic passwords labelled "envsecret [group] NAME", with the
variable name as the service. The list never reads a value; a value is only
decrypted when you open its card with Enter.

  arrows / j k   move            enter   open the card
  a              add             e       edit
  d              delete          /       filter
  s              sort            t       colour scheme
  q              quit

In a card: c copies to the clipboard, r shows or hides the value, e edits,
esc goes back. The value starts hidden. A copy is marked concealed, so
clipboard managers skip it, stays on this Mac, and is cleared 45 seconds
later if the clipboard still holds it.

  envsecret --list          group, name and date, no TUI, for scripting
  envsecret --themes        the colour schemes on offer
  envsecret --theme NAME    run in one without saving it
"""
import curses
import locale
import os
import re
import signal
import subprocess
import sys
import termios
from collections import namedtuple
from datetime import datetime, timezone

# Every tool by its full path. PATH can hold an empty entry, which means the
# current directory, and a `security` or `pbcopy` sitting in whatever
# directory the TUI was started from must never be handed a value.
SECURITY = "/usr/bin/security"
OSASCRIPT = "/usr/bin/osascript"
PBCOPY = "/usr/bin/pbcopy"

KEYCHAIN = os.path.expanduser("~/Library/Keychains/login.keychain-db")
ACCOUNT = os.environ.get("USER", "")
LABEL_RE = re.compile(r'0x00000007 <blob>="envsecret \[([^\]]+)\] ([^"]+)"')
CDAT_RE = re.compile(r'"cdat"<timedate>=0x[0-9A-F]*\s+"(\d{14})Z')
PASSWORD_RE = re.compile(r'^password: (?:0x([0-9A-F]*)(?: .*)?|"(.*)")$', re.M)

# `security -i` reads its commands in 4095-byte lines. A longer line is not
# refused: the value is cut to fit and stored, and the rest of the line runs
# as a command of its own. Every write stays well under that.
LINE_MAX = 4000

# added is the keychain's own creation stamp, 14 digits of UTC, or "" if the
# item somehow carries none.
Item = namedtuple("Item", "group name added")


# ---------------------------------------------------------------- keychain

def index(order="name"):
    """[Item] in the asked-for order, or None if the keychain could not be read.
    Reads metadata only, never a value.

    One pass over the dump. Each item is a block of attributes opening with a
    "keychain:" line: the label carries the group and the name, and "cdat" a
    few lines below it carries the date the item was created. "cdat" survives
    a value edit, since writing over an item with -U bumps "mdat" and leaves
    the creation stamp alone.

    dump-keychain exits 0 with no output for a keychain it cannot open, so the
    output itself is the only sign the read worked. Treating that as "no
    secrets" would invite adding one that already exists.
    """
    out = subprocess.run([SECURITY, "dump-keychain", KEYCHAIN],
                         capture_output=True, text=True).stdout
    if "keychain: " not in out:
        return None
    items, pending = [], None
    for line in out.splitlines():
        if line.startswith("keychain: "):       # a new block: close the last
            if pending:
                items.append(Item(*pending, ""))   # no cdat in that block
            pending = None
            continue
        label = LABEL_RE.search(line)
        if label:
            pending = label.groups()
        elif pending:
            stamp = CDAT_RE.search(line)
            if stamp:
                items.append(Item(*pending, stamp.group(1)))
                pending = None
    if pending:
        items.append(Item(*pending, ""))
    return sort_items(items, order)


def day(stamp):
    """The local date of a keychain stamp, which the keychain keeps in UTC.

    Shown as DD.MM.YYYY. Nothing sorts on this string: the order is keyed to
    the raw stamp, which is why the displayed format can be whatever reads
    best.
    """
    try:
        utc = datetime.strptime(stamp, "%Y%m%d%H%M%S").replace(tzinfo=timezone.utc)
        return utc.astimezone().strftime("%d.%m.%Y")
    except ValueError:
        return ""


SORT_CYCLE = ("name", "new", "old")


def sort_items(items, order):
    """By group and name, or by date with names still settled alphabetically."""
    by_name = sorted(items, key=lambda i: (i.group, i.name))
    if order == "new":
        return sorted(by_name, key=lambda i: i.added, reverse=True)
    if order == "old":
        return sorted(by_name, key=lambda i: i.added)
    return by_name


def plain(text):
    """Printable ASCII only, the one range that survives the keychain CLI both
    ways. Anything else, a tab or an accent, comes back from -w as bare hex."""
    return text.isascii() and text.isprintable()


def read_value(name):
    """The stored value, or None if it cannot be read.

    -g rather than -w: -w prints a value holding any byte outside printable
    ASCII as bare hex, which cannot be told apart from a value that really is
    hex, and an edit that kept it would store the hex. -g marks the case as
    "password: 0x<hex>", the raw bytes, and quotes everything else.
    """
    r = subprocess.run([SECURITY, "find-generic-password", "-a", ACCOUNT,
                        "-s", name, "-g", KEYCHAIN],
                       capture_output=True, text=True)
    found = PASSWORD_RE.search(r.stderr) if r.returncode == 0 else None
    if not found:
        return None
    raw, quoted = found.groups()
    if raw is not None:
        return bytes.fromhex(raw).decode("utf-8", "replace")
    return quoted


def quote(arg):
    """One argument for `security -i`, whose reader takes double quotes with
    backslash escapes. Every printable ASCII character survives this."""
    return '"' + arg.replace("\\", "\\\\").replace('"', '\\"') + '"'


def write_value(group, name, value, note, replace=False):
    """Store a secret. None once it is stored and read back intact, else why not.

    Through `security -i`, one command on stdin, rather than piping the value
    into the -w prompt: that prompt goes through readpassphrase(), which keeps
    128 characters and drops the rest without an error. A value never goes on
    a command line either, where ps would show it.

    replace=False writes a new item only. security then refuses an existing
    account and service, including an item some other tool made, instead of
    overwriting it as -U would. Only an edit of the same name replaces.

    Reading the value back is the check that matters: whatever the CLI did,
    the caller only hears "stored" when the keychain holds exactly this value.
    stderr is never shown, since a failed command can echo part of its line.
    """
    if not plain(value):
        return "plain ASCII only: the keychain CLI reads anything else back as hex"
    fields = (("-a", ACCOUNT), ("-s", name), ("-l", f"envsecret [{group}] {name}"),
              ("-j", note), ("-T", SECURITY))
    command = " ".join(["add-generic-password"]
                       + [f"{flag} {quote(arg)}" for flag, arg in fields]
                       + (["-U"] if replace else [])
                       + ["-w", quote(value), quote(KEYCHAIN)])
    if len(command.encode()) > LINE_MAX:
        return f"too long for the keychain CLI ({len(value)} chars)"
    r = subprocess.run([SECURITY, "-i"], input=command + "\n",
                       capture_output=True, text=True, start_new_session=True)
    if "already exists" in r.stderr:
        return f"{name} is already in the keychain, perhaps not as an envsecret item"
    if read_value(name) != value:
        return "the keychain did not keep that value; check the card before retrying"
    return None


def delete_value(name):
    return subprocess.run([SECURITY, "delete-generic-password",
                           "-a", ACCOUNT, "-s", name, KEYCHAIN],
                          capture_output=True).returncode == 0


# --------------------------------------------------------------- clipboard

CLIP_SECONDS = 45
PASTEBOARD = ""                 # "" is the general one; tests use a named one

# JavaScript for osascript, run(argv) = [mode, pasteboard name, ...].
#   copy   the value comes on stdin, never in argv. The concealed and transient
#          markers go on before the text, since a clipboard manager polling
#          between the two writes would otherwise record it; Maccy skips both.
#          CurrentHostOnly keeps it off Universal Clipboard. Prints changeCount.
#   clear  waits, then empties the pasteboard only if changeCount still
#          matches, so anything copied since is left alone.
CLIP_JS = r"""
ObjC.import("AppKit");
function run(argv) {
  var pb = argv[1] ? $.NSPasteboard.pasteboardWithName(argv[1])
                   : $.NSPasteboard.generalPasteboard;
  if (argv[0] === "copy") {
    var data = $.NSFileHandle.fileHandleWithStandardInput.readDataToEndOfFile;
    var text = $.NSString.alloc.initWithDataEncoding(data, $.NSUTF8StringEncoding);
    pb.prepareForNewContentsWithOptions($.NSPasteboardContentsCurrentHostOnly);
    pb.setStringForType("", "org.nspasteboard.ConcealedType");
    pb.setStringForType("", "org.nspasteboard.TransientType");
    if (!pb.setStringForType(text, "public.utf8-plain-text")) throw new Error("refused");
    return String(pb.changeCount);
  }
  if (argv[0] === "clear") {
    delay(Number(argv[3]));
    if (String(pb.changeCount) === argv[2]) pb.clearContents;
    return "";
  }
}
"""


def clip(text):
    """Copy a secret. Returns "concealed", "plain", or None if nothing worked.

    "concealed" is the osascript path above, with its clear already scheduled
    in a process of its own: it fires on time even if the TUI is closed,
    killed or crashes first. "plain" is the pbcopy fallback, which clipboard
    managers do record and which only run()'s exit clears.
    """
    try:
        r = subprocess.run([OSASCRIPT, "-l", "JavaScript", "-e", CLIP_JS,
                            "copy", PASTEBOARD],
                           input=text, capture_output=True, text=True, timeout=10)
        stamp = r.stdout.strip()
        if r.returncode == 0 and stamp.isdigit():
            subprocess.Popen([OSASCRIPT, "-l", "JavaScript", "-e", CLIP_JS,
                              "clear", PASTEBOARD, stamp, str(CLIP_SECONDS)],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
            return "concealed"
    except (OSError, subprocess.SubprocessError):
        pass
    try:
        subprocess.run([PBCOPY], input=text, text=True, check=True)
        return "plain"
    except (OSError, subprocess.SubprocessError):
        return None


# ---------------------------------------------------------------- settings

CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME",
                                     os.path.expanduser("~/.config")),
                      "envsecret", "config")


def load_config():
    """`key = value` lines. A missing or unreadable file is just defaults."""
    cfg = {}
    try:
        with open(CONFIG) as f:
            for line in f:
                line = line.split("#", 1)[0].strip()
                if "=" in line:
                    k, v = line.split("=", 1)
                    cfg[k.strip()] = v.strip()
    except OSError:
        pass
    return cfg


def save_setting(key, value):
    cfg = load_config()
    cfg[key] = value
    try:
        os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
        tmp = f"{CONFIG}.new"
        with open(tmp, "w") as f:
            f.write("# envsecret settings\n")
            for k, v in sorted(cfg.items()):
                f.write(f"{k} = {v}\n")
        os.replace(tmp, CONFIG)                 # never a half-written config
        return True
    except OSError:
        return False


