ACTIVE_THEME = "default"
EXTRA = {}                      # role -> attributes the theme adds to the pair

BASE16 = ((0, 0, 0), (205, 0, 0), (0, 205, 0), (205, 205, 0), (0, 0, 238),
          (205, 0, 205), (0, 205, 205), (229, 229, 229), (127, 127, 127),
          (255, 0, 0), (0, 255, 0), (255, 255, 0), (92, 92, 255),
          (255, 0, 255), (0, 255, 255), (255, 255, 255))


def rgb(idx):
    """The colour xterm shows for a palette index."""
    if idx < 16:
        return BASE16[idx]
    if idx < 232:
        i = idx - 16
        steps = (0, 95, 135, 175, 215, 255)
        return steps[i // 36], steps[(i // 6) % 6], steps[i % 6]
    v = 8 + (idx - 232) * 10
    return v, v, v


def fit(idx):
    """Fold a 256-colour index onto whatever this terminal actually has."""
    if idx < 0 or idx < curses.COLORS:
        return idx
    want = rgb(idx)
    have = range(min(curses.COLORS, 16))
    return min(have, key=lambda c: sum((a - b) ** 2 for a, b in zip(rgb(c), want)))


def apply_theme(name):
    """Bind a theme to the colour pairs. Safe to call while the TUI is up."""
    global ACTIVE_THEME
    ACTIVE_THEME = name if name in THEMES else "default"
    theme = THEMES[ACTIVE_THEME]
    overrides = theme.get("attrs", {})
    EXTRA.clear()
    for role in ROLE_ORDER:
        EXTRA[role] = overrides.get(role, ROLE_ATTR.get(role, 0))
    if not curses.has_colors():
        # Monochrome: reverse and dim still separate the rows from the page.
        EXTRA.update({"sel": curses.A_REVERSE, "zebra": curses.A_DIM})
        return ACTIVE_THEME
    for role in ROLE_ORDER:
        fg, bg = theme[role]
        try:
            curses.init_pair(PAIR[role], fit(fg), fit(bg))
        except curses.error:
            pass
    return ACTIVE_THEME


def retheme(scr, name):
    """Switch themes, background included, so erase() fills with the new one.

    Rebinding the pairs is enough to recolour what is already on screen:
    ncurses repaints the cells that use a pair whose contents changed.
    """
    apply_theme(name)
    scr.bkgd(" ", paint("body"))


def paint(role):
    """The attribute for a role: its colour pair plus any attribute it adds.

    Pass this to addstr rather than putting it on the window with attron. A
    string holding any non-ASCII character (this UI is full of "·") goes out
    through the wide-character path, which ignores the window's colour and
    falls back to the background pair: with a theme painting a background,
    every such line came out in the body colours. An attribute handed to
    addstr is applied to the write itself and survives that path.
    """
    return curses.color_pair(PAIR[role]) | EXTRA.get(role, 0)


# -------------------------------------------------------------------- ui


def put(win, y, x, text, attr=0):
    """addstr that clips to the window and never raises.

    curses refuses any write past the last row or into the last cell, and a
    terminal can shrink to a few rows at any moment. One refused write used to
    take the whole TUI down with a traceback.
    """
    h, w = win.getmaxyx()
    if not (0 <= y < h and 0 <= x < w - 1):
        return
    try:
        win.addstr(y, x, text[: w - 1 - x], attr)
    except curses.error:
        pass


def draw_frame(scr, title, hint):
    h, w = scr.getmaxyx()
    scr.erase()
    put(scr, 0, 0, f" {title}".ljust(w - 1), paint("head"))
    if h > 1:
        put(scr, h - 1, 0, f" {hint}".ljust(w - 1), paint("foot"))
    return h, w


# read_key's markers for the start and end of a bracketed paste.
PASTE_START, PASTE_END = -200, -201


def read_key(win):
    """getch that reads escape sequences as a whole instead of as Esc.

    run() switches the terminal into bracketed-paste mode, which wraps a paste
    in ESC[200~ ... ESC[201~; those come back as PASTE_START and PASTE_END so
    each screen can decide what a paste means there. A lone Esc is the case
    where nothing follows it. Any other sequence returns None, "ignore this".
    """
    ch = win.getch()
    if ch != 27:
        return ch
    win.nodelay(True)
    try:
        nxt = win.getch()
        if nxt == -1:
            return 27                       # real, lone Esc
        if nxt != ord("["):
            return None
        seq = ""
        for _ in range(8):                  # the rest of the CSI sequence
            c = win.getch()
            if c == -1:
                break
            seq += chr(c)
            if 0x40 <= c < 0x7F:
                break
        return {"200~": PASTE_START, "201~": PASTE_END}.get(seq)
    finally:
        win.nodelay(False)


def read_paste(win):
    """The text of a paste whose PASTE_START was just read, as a str.

    Also ends on a pause in the input, so a terminal that never sends the
    closing marker cannot leave the screen stuck in paste mode.
    """
    data = bytearray()
    win.timeout(200)
    try:
        while True:
            ch = read_key(win)
            if ch in (PASTE_END, -1):
                break
            if ch is not None and 0 <= ch < 256:
                data.append(ch)
    finally:
        win.timeout(-1)
    return data.decode("utf-8", "replace")


def more_input(win):
    """True if another key is already waiting, which after a tab or a line
    break means a paste is arriving without bracketed-paste markers."""
    win.timeout(15)
    ch = win.getch()
    win.timeout(-1)
    if ch == -1:
        return False
    curses.ungetch(ch)
    return True


def prompt(scr, label):
    """One-line editor on the bottom row. Esc cancels and returns None."""
    h, w = scr.getmaxyx()
    buf = ""
    curses.curs_set(1)
    try:
        while True:
            scr.move(h - 1, 0)
            scr.clrtoeol()
            put(scr, h - 1, 0, f" {label}", paint("key"))
            put(scr, h - 1, len(label) + 2, buf[-max(1, w - len(label) - 4):],
                paint("body"))
            scr.refresh()
            ch = read_key(scr)
            if ch == PASTE_START:           # a pasted filter is just text
                buf += "".join(c for c in read_paste(scr) if " " <= c <= "~")
            elif ch == 27:
                return None
            elif ch in (10, 13):
                return buf
            elif ch in (curses.KEY_BACKSPACE, 127, 8):
                buf = buf[:-1]
            elif ch == 21:                  # ^u
                buf = ""
            elif ch is not None and 32 <= ch < 127:
                buf += chr(ch)
    finally:
        curses.curs_set(0)


def confirm(scr, question):
    h, w = scr.getmaxyx()
    # Clip the question, keep [y/N] on screen.
    tail = " [y/N] "
    room = w - 1 - len(tail)
    text = f" {question}"
    if len(text) > room:
        text = text[: max(0, room - 1)] + "…"
    scr.move(h - 1, 0)
    scr.clrtoeol()
    put(scr, h - 1, 0, text + tail, paint("warn"))
    scr.refresh()
    # Only a key pressed after the question counts: anything already waiting
    # is the tail of a paste, and a "y" inside it once confirmed a delete.
    curses.flushinp()
    ch = read_key(scr)
    if ch == PASTE_START:
        read_paste(scr)
    return ch in (ord("y"), ord("Y"))


def flash(scr, msg, role="val"):
    """A message on the bottom row for 900 ms, or until the next key, which is
    then handled as usual rather than lost."""
    h, w = scr.getmaxyx()
    scr.move(h - 1, 0)
    scr.clrtoeol()
    put(scr, h - 1, 0, f" {msg}", paint(role) | curses.A_BOLD)
    scr.refresh()
    scr.timeout(900)
    ch = scr.getch()
    scr.timeout(-1)
    if ch != -1:
        curses.ungetch(ch)


def card(scr, item, clipboard):
    """Open one secret. The value is decrypted here and nowhere else.

    The value starts hidden: opening a card during a screen share, or with
    another pane reading this one, shows stars. c copies without revealing.
    clipboard collects what each copy went through, for run()'s exit.

    Returns "edit" when the user asks for the edit form, so the list can open
    it with the card already closed and read a fresh index afterwards.
    """
    group, name = item.group, item.name
    value = read_value(name)
    if value is None:
        flash(scr, f"could not read {name}", "warn")
        return None
    revealed = False
    while True:
        h, w = draw_frame(scr, f"envsecret  ·  {name}",
                          "c copy   r show/hide   e edit   esc back")
        rows = [("group", group), ("variable", name),
                ("added", day(item.added)), ("length", f"{len(value)} chars")]
        y = 2
        for k, v in rows:
            put(scr, y, 2, f"{k:<10}", paint("dim"))
            put(scr, y, 13, v, paint("body"))
            y += 1
        y += 1
        put(scr, y, 2, "value", paint("dim"))
        y += 1
        shown = value if revealed else "*" * min(len(value), 48)
        width = max(10, w - 6)              # wrap the value across the width
        for i in range(0, len(shown), width):
            if y >= h - 2:
                put(scr, y, 4, "...", paint("val"))
                break
            put(scr, y, 4, shown[i:i + width], paint("val"))
            y += 1
        scr.refresh()

        ch = read_key(scr)
        if ch == PASTE_START:
            read_paste(scr)
        elif ch in (27, ord("q"), curses.KEY_LEFT):
            return None
        elif ch == ord("e"):
            return "edit"
        elif ch in (ord("c"), ord("y")):
            how = clip(value)
            if how:
                clipboard.add(how)
            if how == "concealed":
                flash(scr, f"copied, hidden from clipboard history, "
                           f"cleared in {CLIP_SECONDS} s")
            elif how == "plain":
                flash(scr, "copied with pbcopy, cleared when you quit", "warn")
            else:
                flash(scr, "clipboard unavailable", "warn")
        elif ch == ord("r"):
            revealed = not revealed


NAME_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
# One word, lowercase, so the label parsers never see a bracket, a quote or a
# space, and `loadgroup cloudflare` never meets a "Cloudflare" next to it.
GROUP_RE = re.compile(r"^[a-z0-9][a-z0-9_.-]*$")

FORM_FIELDS = (("Group", False), ("Variable name", False), ("Secret value", True))

ADD_HINTS = ("loads with `loadgroup <group>`, e.g. cloudflare",
             "UPPER_SNAKE_CASE, normalised on save",
             "never echoed; paste one line")

EDIT_HINTS = ("loads with `loadgroup <group>`, e.g. cloudflare",
              "a new name rewrites the item and drops the old one",
              "leave empty to keep the stored value")


def normalise_name(raw):
    return raw.strip().upper().replace(" ", "_").replace("-", "_")


def normalise_group(raw):
    return raw.strip().lower()


def check(group, name, value, taken, keep_allowed=False):
    """The rules both forms share: None if the fields can be saved, else
    (field index, message). keep_allowed lets an empty value mean "keep the
    stored one", which only the edit form offers."""
    if not GROUP_RE.match(group):
        return 0, "one lowercase word: letters, digits, _ . -"
    if not NAME_RE.match(name):
        return 1, "must be a valid shell variable name"
    if name in taken:
        return 1, f"{name} already exists; open it and press e to change it"
    if not value and not keep_allowed:
        return 2, "value is empty"
    if value and not plain(value):
        return 2, "plain ASCII only: the keychain CLI reads anything else back as hex"
    return None


def secret_form(scr, title, initial, hints, save):
    """The panel behind both add and edit: three labelled fields, the secret
    in one of its own.

    save(group, name, value) owns the rules and the keychain write. It returns
    None once the item is stored, or (field index, message) to put the cursor
    back on the field at fault with the reason underneath it. Returns the saved
    (group, name) on success, or None if the user escaped.

    A paste is taken whole and refused if it holds a tab or a line break:
    typed, those move between fields and save, so a pasted multi-line key used
    to store its first line and then run the rest as list commands.
    """
    vals = list(initial)
    idx, error = 0, ""
    win, size = None, None
    curses.curs_set(1)
    try:
        while True:
            h, w = scr.getmaxyx()
            if (h, w) != size:              # first pass, or the terminal resized
                size, win = (h, w), None
                scr.erase()
                if h >= 16 and w >= 46:
                    bh, bw = 15, min(w - 4, 68)
                    win = curses.newwin(bh, bw, (h - bh) // 2, (w - bw) // 2)
                    win.bkgd(" ", paint("body"))
                    win.keypad(True)
                scr.refresh()
            if win is None:                 # too small: keep what was typed
                scr.erase()
                put(scr, 0, 0, "enlarge the terminal (16 x 46) · esc cancels",
                    paint("warn"))
                scr.refresh()
                ch = read_key(scr)
                if ch == 27:
                    return None
                continue

            win.erase()
            win.box()
            put(win, 0, 2, f" {title} "[:bw - 4], paint("head"))
            inner = bw - 8
            cy = cx = 1
            for i, (label, mask) in enumerate(FORM_FIELDS):
                row, active = 2 + i * 3, i == idx
                put(win, row, 3, label, paint("key") if active else paint("dim"))
                shown = ("*" * len(vals[i])) if mask else vals[i]
                shown = shown[-inner:]      # keep the tail visible while typing
                put(win, row + 1, 3, "[" + shown.ljust(inner) + "]",
                    paint("val") if active else paint("dim"))
                if active:
                    cy, cx = row + 1, 4 + len(shown)
            put(win, bh - 3, 3, error or hints[idx],
                paint("warn") if error else paint("dim"))
            put(win, bh - 2, 3, "tab move · enter next · ^s save · ^u clear · esc cancel",
                paint("dim"))
            win.move(cy, cx)
            win.refresh()

            ch = read_key(win)
            if ch is None or ch == curses.KEY_RESIZE:
                continue
            if ch == PASTE_START:
                text = read_paste(win).rstrip("\r\n")
                if any(c in text for c in "\r\n\t"):
                    error = "the paste held a line break or a tab; paste one line"
                elif not plain(text):
                    error = "plain ASCII only: the keychain CLI reads anything else back as hex"
                else:
                    vals[idx] += text
                    error = ""
                continue
            if ch in (9, 10, 13) and more_input(win):
                # the same paste, from a terminal that sends no markers
                curses.flushinp()
                error = "the paste held a line break or a tab; paste one line"
                continue
            if ch == 27:
                return None
            if ch in (9, curses.KEY_DOWN):
                idx, error = (idx + 1) % 3, ""
            elif ch in (curses.KEY_BTAB, curses.KEY_UP):
                idx, error = (idx - 1) % 3, ""
            elif ch in (curses.KEY_BACKSPACE, 127, 8):
                vals[idx] = vals[idx][:-1]
            elif ch == 21:                  # ^u
                vals[idx], error = "", ""
            elif 32 <= ch < 127:
                vals[idx] += chr(ch)
            elif 128 <= ch < 256:           # the first byte of a typed accent
                curses.flushinp()
                error = "plain ASCII only: the keychain CLI reads anything else back as hex"
            elif ch in (10, 13) and idx < 2:
                idx, error = idx + 1, ""
            elif ch in (10, 13, 19):        # enter on the last field, or ^s
                group, name = normalise_group(vals[0]), normalise_name(vals[1])
                problem = save(group, name, vals[2])
                if problem is None:
                    return group, name
                idx, error = problem
    finally:
        curses.flushinp()
        curses.curs_set(0)
        scr.touchwin()
        scr.refresh()


def add_flow(scr):
    """Write a new secret. Returns the (group, name) written, else None."""
    items = index()
    if items is None:
        flash(scr, "could not read the keychain, so nothing can be added", "warn")
        return None
    existing = {it.name for it in items}

    def save(group, name, value):
        problem = check(group, name, value, existing)
        if problem:
            return problem
        failed = write_value(group, name, value, "added via envsecret")
        return (2, failed) if failed else None

    saved = secret_form(scr, "add secret", ("", "", ""), ADD_HINTS, save)
    if saved:
        flash(scr, f"added {saved[1]} to [{saved[0]}]")
    return saved


def edit_flow(scr, group, name):
    """Change the group, the name or the value of a secret that already exists.

    security has no attribute editor, so every change here is a rewrite. A new
    value or group rewrites the item in place with -U, matched by account and
    service; the group lives in the label. A new name is a different item: it
    is written without -U, so it can never land on an existing one, read back,
    and only then is the old one removed, so a failure anywhere leaves the
    secret whole under its old name. An empty value field means "keep what is
    there", which is the one case that reads the value back out of the
    keychain, and a stored value outside printable ASCII is refused rather
    than rewritten.

    Returns the (group, name) now holding the secret, else None.
    """
    items = index()
    if items is None:
        flash(scr, "could not read the keychain, so nothing can be edited", "warn")
        return None
    taken = {it.name for it in items} - {name}
    unchanged = []

    def save(new_group, new_name, value):
        problem = check(new_group, new_name, value, taken, keep_allowed=True)
        if problem:
            return problem
        if not value and (new_group, new_name) == (group, name):
            unchanged.append(True)          # nothing to write
            return None
        if not value:
            value = read_value(name)
            if value is None:
                return 2, f"could not read {name}; type a new value"
            if not plain(value):
                return 2, "the stored value is not plain ASCII; type it again to move it"
        renamed = new_name != name
        failed = write_value(new_group, new_name, value, "edited via envsecret",
                             replace=not renamed)
        if failed:
            return 2, failed
        if renamed and not delete_value(name):
            return 1, f"wrote {new_name}, but {name} is still in the keychain"
        return None

    saved = secret_form(scr, f"edit {name}", (group, name, ""), EDIT_HINTS, save)
    if saved:
        g, n = saved
        if unchanged:
            flash(scr, "no changes")
        elif n != name:
            flash(scr, f"renamed {name} to {n} in [{g}]")
        elif g != group:
            flash(scr, f"moved {n} to [{g}]")
        else:
            flash(scr, f"updated {n}")
    return saved


def no_flow_control():
    """Stop the tty eating ^s, and hand back what it was.

    curses.wrapper puts the terminal in cbreak, which leaves IXON set, so the
    line discipline swallows ^s as XOFF and the form's save key never reaches
    getch at all. Clearing IXON for the life of the TUI is the whole fix; the
    saved attributes go back on the way out.
    """
    try:
        fd = sys.stdin.fileno()
        saved = termios.tcgetattr(fd)
        live = termios.tcgetattr(fd)
        live[0] &= ~termios.IXON
        termios.tcsetattr(fd, termios.TCSANOW, live)
        return saved
    except (termios.error, ValueError, OSError):
        return None


def restore_flow_control(saved):
    if saved is not None:
        try:
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, saved)
        except (termios.error, ValueError, OSError):
            pass


LIST_HINT = ("enter open   a add   e edit   d delete   "
             "/ filter   s sort   t theme   q quit")

# ▴ ascending, ▾ descending, against whichever column the order is keyed to.
SORT_LABELS = {"name": ("name ▴", "added"),
               "new": ("name", "added ▾"),
               "old": ("name", "added ▴")}


GAP = 2                 # least space between the name and the date column


def columns(left, tail, w):
    """One row: the left columns, then the right ones flush to the margin."""
    return f"{left}{' ' * max(GAP, w - 6 - len(left) - len(tail))}{tail}"


def fit_name(name, room):
    """Clip a name so the columns to its right keep their place."""
    if room < 4:
        return name[:max(0, room)]
    return name if len(name) <= room else f"{name[:room - 1]}…"


def draw_list(scr, shown, sel, top, title, order, empty="nothing here. press 'a' to add one."):
    """Paint the list. Split out of run so the theme picker can preview on it."""
    h, w = draw_frame(scr, title, LIST_HINT)
    # Below this the date column would leave nothing for the names.
    dated = w >= 58
    name_label, date_label = SORT_LABELS[order]
    # The header's right-hand columns are padded to the same width as a row's,
    # so one name allowance holds for both and the labels sit over their column.
    tail = f"{date_label:>10}  {'value':<8}" if dated else f"{'value':<8}"
    room = w - 6 - len(tail) - 13 - GAP
    header = f"  {'group':<11}{name_label}"
    put(scr, 1, 0, columns(header, tail, w).ljust(w - 1), paint("dim"))

    last_group = None
    y = 2
    for i in range(top, min(len(shown), top + h - 3)):
        it = shown[i]
        mark = "> " if i == sel else "  "
        # A repeated group reads as an indent only where the order keeps those
        # rows together; by date they are scattered, so each one names itself.
        repeat = order == "name" and it.group == last_group
        grp = " " * 11 if repeat else f"{it.group:<11}"
        last_group = it.group
        tail = f"{day(it.added):>10}  {'*' * 8}" if dated else "*" * 8
        line = columns(f"{mark}{grp}{fit_name(it.name, room)}", tail, w)
        # Zebra striping keyed to the item's index, not the screen row, so a row
        # keeps its shade while scrolling instead of flickering between shades as
        # the viewport moves. Padding the line to the full width is what makes a
        # theme's cursor and stripe read as bars rather than as tinted glyphs.
        attr = paint("sel") if i == sel else paint("zebra" if i % 2 else "body")
        put(scr, y, 0, line.ljust(w - 1), attr)
        y += 1

    if not shown:
        put(scr, 3, 2, empty, paint("dim"))
    scr.refresh()
    return h, w


def theme_picker(scr, redraw):
    """Pick a colour scheme, previewing it on the list behind the panel.

    redraw() repaints whatever the panel floats over, so moving through the
    names shows each theme on real content instead of on a swatch. Enter keeps
    the highlighted one and saves it; esc puts back the one that was active on
    the way in.
    """
    names = list(THEMES)
    was = ACTIVE_THEME
    idx = names.index(was) if was in names else 0
    bh, bw = len(names) + 4, 32
    h, w = scr.getmaxyx()
    if h < bh + 2 or w < bw + 2:
        flash(scr, "terminal too small for the theme list", "warn")
        return
    win = curses.newwin(bh, bw, (h - bh) // 2, (w - bw) // 2)
    win.keypad(True)
    kept = None
    try:
        while True:
            retheme(scr, names[idx])
            redraw()
            win.bkgd(" ", paint("body"))
            win.erase()
            win.box()
            put(win, 0, 2, " colour scheme "[:bw - 4], paint("head"))
            for i, name in enumerate(names):
                row = f"{'> ' if i == idx else '  '}{name}"
                attr = paint("sel") if i == idx else paint("body")
                put(win, 1 + i, 1, row.ljust(bw - 2)[:bw - 2], attr)
            put(win, bh - 2, 2, "enter keep · esc revert"[:bw - 4], paint("foot"))
            win.refresh()

            ch = read_key(win)
            if ch == PASTE_START:
                read_paste(win)
            elif ch in (curses.KEY_DOWN, ord("j")):
                idx = (idx + 1) % len(names)
            elif ch in (curses.KEY_UP, ord("k")):
                idx = (idx - 1) % len(names)
            elif ch in (10, 13):
                kept = names[idx]
                break
            elif ch in (27, ord("q")):
                break
    finally:
        del win
        scr.touchwin()
        scr.refresh()

    if kept is None:
        retheme(scr, was)
    redraw()
    if kept:
        flash(scr, f"theme: {kept}" if save_setting("theme", kept)
                   else f"theme: {kept}, but {CONFIG} could not be written")


# Bracketed paste on and off. zsh turns it off before running a command, so
# without this a paste reaches the TUI as bare keystrokes.
BRACKETED_ON, BRACKETED_OFF = "\033[?2004h", "\033[?2004l"


def hang_up(signum, frame):
    """Closing the window sends SIGHUP, and SIGTERM is a plain kill; either
    one's default action ends Python on the spot, skipping every finally.
    Raising SystemExit instead lets run() clean up on the way out."""
    sys.exit(128 + signum)


def terminal(sequence):
    try:
        sys.stdout.write(sequence)
        sys.stdout.flush()
    except OSError:                         # the window is already gone
        pass


def run(scr, theme, order):
    curses.curs_set(0)
    if hasattr(curses, "set_escdelay"):
        # ncurses holds a lone Esc for a whole second by default, waiting to
        # see whether it opens an arrow key, and a key pressed in that second
        # went with it. Local terminals send a sequence in one burst.
        curses.set_escdelay(25)
    try:
        curses.use_default_colors()     # so a theme can leave colours alone
    except curses.error:
        pass
    retheme(scr, theme)

    tty_state = no_flow_control()
    clipboard = set()
    for sig in (signal.SIGHUP, signal.SIGTERM):
        signal.signal(sig, hang_up)
    terminal(BRACKETED_ON)
    try:
        browse(scr, order, clipboard)
    finally:
        terminal(BRACKETED_OFF)
        restore_flow_control(tty_state)
        # A concealed copy clears itself on its own timer, whatever happens
        # here, so quitting straight after copying leaves time to paste. Only
        # a pbcopy fallback copy is wiped now, on every way out.
        if "plain" in clipboard:
            try:
                subprocess.run([PBCOPY], input="", text=True)
            except OSError:
                pass


def browse(scr, order, clipboard):
    """The list and its keys, until quit."""
    def reload():
        got = index(order)
        return (got, False) if got is not None else ([], True)

    items, broken = reload()
    sel, top, filt, focus = 0, 0, "", None

    while True:
        shown = [it for it in items
                 if filt.lower() in f"{it.group} {it.name}".lower()] if filt else items
        sel = max(0, min(sel, len(shown) - 1))
        if focus:
            # stay on the item just written or just selected, wherever the
            # current order has put it.
            for i, it in enumerate(shown):
                if (it.group, it.name) == focus:
                    sel = i
                    break
            focus = None
        if broken:
            title = "envsecret  ·  keychain not readable"
            empty = "could not read the keychain. nothing is listed, and nothing can be added."
        else:
            title = f"envsecret  ·  {len(shown)} secret{'s' if len(shown) != 1 else ''}"
            empty = (f"no match for '{filt}'. esc clears the filter." if filt
                     else "nothing here. press 'a' to add one.")
        if filt:
            title += f"  ·  filter: {filt}"
        body = max(1, scr.getmaxyx()[0] - 3)
        if sel < top:
            top = sel
        if sel >= top + body:
            top = sel - body + 1
        draw_list(scr, shown, sel, top, title, order, empty)

        ch = read_key(scr)
        if ch is None:
            continue
        if ch == PASTE_START:           # a paste means nothing on the list
            read_paste(scr)
        elif ch == ord("q"):
            break
        elif ch == 27:                 # esc clears a filter, else asks first
            if filt:
                filt, sel = "", 0
            elif confirm(scr, "quit envsecret?"):
                break
        elif ch in (curses.KEY_DOWN, ord("j")):
            sel += 1
        elif ch in (curses.KEY_UP, ord("k")):
            sel -= 1
        elif ch == curses.KEY_NPAGE:
            sel += body
        elif ch == curses.KEY_PPAGE:
            sel -= body
        elif ch in (10, 13, curses.KEY_RIGHT) and shown:
            if card(scr, shown[sel], clipboard) == "edit":
                focus = edit_flow(scr, shown[sel].group, shown[sel].name)
                if focus:
                    items, broken = reload()
        elif ch == ord("s"):
            if shown:                   # keep the cursor on the same secret
                focus = (shown[sel].group, shown[sel].name)
            order = SORT_CYCLE[(SORT_CYCLE.index(order) + 1) % len(SORT_CYCLE)]
            save_setting("sort", order)
            items = sort_items(items, order)
        elif ch == ord("t"):
            theme_picker(scr, lambda: draw_list(scr, shown, sel, top, title,
                                                order, empty))
        elif ch == ord("/"):
            got = prompt(scr, "filter:")
            filt = got or ""
            sel = 0
        elif ch == ord("a"):
            focus = add_flow(scr)
            if focus:
                items, broken = reload()
        elif ch == ord("e") and shown:
            focus = edit_flow(scr, shown[sel].group, shown[sel].name)
            if focus:
                items, broken = reload()
        elif ch == ord("d") and shown:
            g, n = shown[sel].group, shown[sel].name
            if confirm(scr, f"delete {n} from [{g}]? this cannot be undone."):
                if delete_value(n):
                    flash(scr, f"deleted {n}")
                    items, broken = reload()
                    sel = max(0, sel - 1)
                else:
                    flash(scr, "delete failed", "warn")


def pick_theme(argv):
    """The saved theme, or the one --theme asks for just this once."""
    theme = load_config().get("theme", "default")
    for i, arg in enumerate(argv):
        if arg == "--theme":
            if i + 1 >= len(argv):
                sys.exit("envsecret: --theme needs a name (see --themes)")
            theme = argv[i + 1]
        elif arg.startswith("--theme="):
            theme = arg.split("=", 1)[1]
        else:
            continue
        if theme not in THEMES:
            sys.exit(f"envsecret: no theme called {theme!r} (see --themes)")
    return theme


def unknown_option(argv):
    """The first argument envsecret does not take, else None. A typo such as
    --lsit in a script used to open the full-screen TUI."""
    after_theme = False
    for arg in argv:
        if after_theme:
            after_theme = False
        elif arg == "--theme":
            after_theme = True
        elif arg not in ("--list", "--themes", "-h", "--help") \
                and not arg.startswith("--theme="):
            return arg
    return None


def main():
    locale.setlocale(locale.LC_ALL, "")      # so "·" is one cell, not two
    argv = sys.argv[1:]
    if "-h" in argv or "--help" in argv:
        print(__doc__.strip())
        return
    bad = unknown_option(argv)
    if bad:
        sys.exit(f"envsecret: unknown option {bad!r} (see -h)")
    if not ACCOUNT:
        sys.exit("envsecret: $USER is not set")
    saved = load_config()
    order = saved.get("sort", "name")
    if order not in SORT_CYCLE:
        order = "name"
    if "--list" in argv:
        items = index(order)
        if items is None:
            sys.exit(f"envsecret: could not read {KEYCHAIN}")
        # Columns sized to the data, two spaces apart, so no field ever runs
        # into the next however long a group or a name gets.
        gw = max((len(it.group) for it in items), default=0)
        nw = max((len(it.name) for it in items), default=0)
        for it in items:
            print(f"{it.group:<{gw}}  {it.name:<{nw}}  {day(it.added)}".rstrip())
        return
    if "--themes" in argv:
        current = saved.get("theme", "default")
        for name in THEMES:
            print(f"{'*' if name == current else ' '} {name}")
        return
    try:
        curses.wrapper(run, pick_theme(argv), order)
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
