#!/bin/sh
LOG="$FAKE_LOG"
# args: -l JavaScript -e JS mode pb [cc secs]
mode="$5"
if [ -n "$FAKE_OSA_FAIL" ]; then exit 1; fi
if [ "$mode" = copy ]; then v=$(cat); echo "osa-copy len=${#v}" >> "$LOG"; echo 7; exit 0; fi
if [ "$mode" = clear ]; then echo "osa-clear cc=$7 after=$8" >> "$LOG"; exit 0; fi
